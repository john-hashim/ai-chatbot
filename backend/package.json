{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -e .env -- tsx watch src/app.ts",
    "dev:neon": "dotenv -e .env.development -e .env -- tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "migrate:dev": "dotenv -e .env.local -e .env -- prisma migrate dev",
    "migrate:deploy:neon": "dotenv -e .env.development -e .env -- prisma migrate deploy",
    "studio": "dotenv -e .env.local -e .env -- prisma studio",
    "studio:neon": "dotenv -e .env.development -e .env -- prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@huggingface/inference": "^4.13.11",
    "@openrouter/sdk": "^0.12.35",
    "@prisma/client": "^6.17.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "google-auth-library": "^10.4.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pgvector": "^0.2.1",
    "playwright": "^1.57.0",
    "resend": "^6.9.4",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^24.5.2",
    "@types/pdfkit": "^0.17.4",
    "@types/word-extractor": "^1.0.6",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.17.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
