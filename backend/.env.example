# ── Backend environment template ───────────────────────────────────────────
# Copy the relevant parts into:
#   .env               → shared secrets (everything EXCEPT the DB URLs)
#   .env.local         → DATABASE_URL + DIRECT_URL for local Postgres
#   .env.development   → DATABASE_URL + DIRECT_URL for Neon (cloud)
# In production (Railway) set these as dashboard env vars, not files.
#
# Switch DB target by running a different npm script (see package.json):
#   npm run dev           → .env.local  + .env
#   npm run dev:neon      → .env.development + .env

# ── Database (in .env.local or .env.development) ────────────────────────────
# Local example:
#   DATABASE_URL="postgresql://USER:PASS@localhost:5432/chatbot?schema=public"
#   DIRECT_URL="postgresql://USER:PASS@localhost:5432/chatbot?schema=public"
# Neon example (pooled for runtime, direct/unpooled for migrations):
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ── Shared secrets (in base .env, or Railway dashboard) ─────────────────────
PORT=3001

# Google OAuth + Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/chatbot/calendar/google/callback
OAUTH_STATE_SECRET=<any_long_random_string>

# Frontend origin (CORS / redirects)
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 (document storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# HuggingFace Inference (BGE-small embeddings, 384-dim)
HUGGINGFACE_API_KEY=

# LLM providers
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Email (Resend)
RESEND_API_KEY=
