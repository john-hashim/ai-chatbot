// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  googleId  String?   @unique
  password  String?   // bcrypt hash; null for Google-only accounts
  avatar    String?
  emailVerified           Boolean   @default(false)
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?
  resetToken              String?   @unique
  resetTokenExpiry        DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  chatbots  Chatbot[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Chatbot {
  id                       String        @id @default(cuid())
  userId                   String
  name                     String
  appearance               String        @default("light") // 'light' or 'dark'
  brandColor               String
  brandColorForHeader      Boolean       @default(false)
  profilePicture           String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents                Document[]
  chatSessions             ChatSession[]
  totalSize                Int           @default(0)
  lastTrained              DateTime?
  initialMessages          String[]
  suggestedMessages        String[]
  showSuggestedAfterFirst  Boolean       @default(false)
  messagePlaceholder       String?
  dismissibleNotice        String?
  footer                   String?
  autoshowDelaySeconds     Int           @default(0)
  autoshowInitialPopup     Boolean       @default(false)
  chatIcon                 String?
  chatBubbleButtonColor    String        @default("#000000")
  chatBubbleButtonPosition String        @default("right")
  instructionType          String        @default("base")
  customInstruction        String?
  selectedModel            String?
  defaultLanguage          String        @default("en") // ISO 639-1 code; user can override per session
  embedConfig              EmbedConfig?
  availabilitySchedules    AvailabilitySchedule[]
  bookingConfig            BookingConfig?
  appointments             Appointment[]
  calendarIntegration      CalendarIntegration?
  endUsers                 EndUser[]
  kanbanColumns            KanbanColumn[]
  leads                    Lead[]

  @@unique([name, userId])
  @@index([userId])
  @@map("chatbots")
}

model EmbedConfig {
  id              String   @id @default(cuid())
  chatbotId       String   @unique
  embedKey        String   @unique
  isActive        Boolean  @default(true)
  allowedDomains  String[] @default([])
  rateLimitPerMin Int      @default(20)
  createAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt
  chatbot         Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@index([embedKey])
  @@map("embed_configs")
 }

model ChatSession {
  id           String        @id @default(cuid())
  chatbotId    String
  endUserId    String?
  source       String        @default("playground") // 'playground', 'iframe', 'widget', 'whatsapp', 'api', 'messenger', 'zendesk', 'slack', 'email', 'salesforce'
  country      String?       // Country name from IP geolocation
  countryCode  String?       // ISO 3166-1 alpha-2 code (e.g., "US", "GB")
  bookingState BookingState  @default(IDLE)
  bookingDraft Json?         // { date?, time?, name?, email? } accumulated across turns
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chatbot      Chatbot       @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  endUser      EndUser?      @relation(fields: [endUserId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]
  leads        Lead[]

  @@index([chatbotId])
  @@index([endUserId])
  @@map("chat_sessions")
}

model EndUser {
  id                String        @id @default(cuid())
  chatbotId         String
  // Resolved identifier: email, E.164 phone, or anonymous uuid from localStorage.
  identifier        String
  kind              EndUserKind
  // Sticky cross-session language choice (ISO 639-1). Falls back to chatbot.defaultLanguage.
  preferredLanguage String?
  // Only set when kind=ANONYMOUS. Bumped on each new session (sliding window)
  // so returning visitors keep their identity; expired rows can be GC'd.
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  chatbot           Chatbot       @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  sessions          ChatSession[]

  @@unique([chatbotId, kind, identifier])
  @@index([chatbotId])
  @@index([expiresAt])
  @@map("end_users")
}

enum EndUserKind {
  EMAIL
  PHONE
  ANONYMOUS
}

enum BookingState {
  IDLE
  AWAITING_DATE
  AWAITING_TIME
  AWAITING_CONTACT
  CONFIRMED
  CANCELLED
}

model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  role         String      // 'user' or 'assistant'
  content      String      @db.Text
  model        String?     // AI model used (null for user)
  temperature  Float?      // AI temperature (null for user)
  tokensUsed   Int?        // tokens consumed (null for user)
  responseTime Int?        // ms to generate (null for user)
  sources         String[]    // document IDs for RAG
  confidenceScore Float?      // RAG confidence score (0-1) for assistant messages
  feedback        String?     // 'like' or 'dislike'
  isAction        Boolean     @default(false) // true if response was an action (not LLM tokens)
  actionType      String?     // e.g. 'booking'
  actionMeta      Json?       // action-specific payload (dates, slots, etc.)
  createdAt    DateTime    @default(now())
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

model Document {
  id          String   @id @default(cuid())
  chatbotId   String 
  name        String
  type        String   // 'document', 'text', 'q&a', 'website'
  subtype     String?  // 'pdf', 'doc', 'txt', 'docx', 'crawled', 'sitemap', 'text-snippet'
  content     String   @db.Text  // Original full text
  size        Int      // Size in bytes
  metadata    Json?    // Store source URL, Q&A pairs, page titles, etc.
  status      String   @default("untrained") // 'untrained', 'trained', 'failed'
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chatbot     Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  chunks      DocumentChunk[]
  
  @@index([chatbotId])
  @@index([chatbotId, type])
  @@index([status])
}

model DocumentChunk {
  id         String                       @id @default(cuid())
  documentId String
  content    String                       @db.Text  // Chunk text content (cleaned)
  embedding  Unsupported("vector(384)")?  // BGE-small embedding vector (384 dimensions)
  position   Int                          // Chunk index/order in document
  tokens     Int?                         // Token count for this chunk
  metadata   Json?                        // {source, title, documentType, subtype}
  createdAt  DateTime                     @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  // Note: Vector similarity index created manually in migration using HNSW
}

model BookingConfig {
  id                  String        @id @default(cuid())
  chatbotId           String        @unique
  chatbot             Chatbot       @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  isEnabled           Boolean       @default(true)
  timezone            String
  appointmentDuration Int
  confirmationMessage String?
  notificationEmail   String?

  locationType        LocationType?
  locationAddress     String?
  locationPhone       String?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("booking_configs")
}

enum LocationType {
  GOOGLE_MEET
  IN_PERSON
  ZOOM
  PHONE
}

model AvailabilitySchedule {
  id           String       @id @default(cuid())
  chatbotId    String
  chatbot      Chatbot      @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  timezone     String
  scheduleType ScheduleType // WEEKLY or SPECIFIC_DATE
  dayOfWeek    Int?         // 0 (Sun) – 6 (Sat)
  specificDate DateTime?    @db.Date
  timeSlots    Json         // [{ startTime: "HH:mm", endTime: "HH:mm" }]

  createdAt    DateTime     @default(now())

  @@index([chatbotId])
}

enum ScheduleType {
  WEEKLY
  SPECIFIC_DATE
}

model Appointment {
    id         String            @id @default(cuid())
    chatbotId  String
    sessionId  String
    email      String
    name       String?
    phone      String?
    interestedTopics String?
    date       String            // "YYYY-MM-DD"
    timeslot   String            // "HH:mm"
    duration   Int?              // minutes, snapshot from BookingConfig at confirmation
    status     AppointmentStatus @default(UPCOMING)
    // Snapshot of booking config at confirmation time so display/cancel logic
    // stays stable if the chatbot owner edits config later.
    timezone        String?
    locationType    LocationType?
    locationAddress String?
    locationPhone   String?
    meetLink        String?
    googleEventId   String?
    createdAt  DateTime          @default(now())
    updatedAt  DateTime          @updatedAt

    chatbot    Chatbot           @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

    @@unique([sessionId, date, timeslot])
    @@index([chatbotId])
    @@index([sessionId])
    @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  UPCOMING
  PAST
  CANCELLED
}

// Two kanban boards per chatbot, discriminated by `board`:
//  - MANUAL: user-managed columns (defaults seeded lazily from
//    DEFAULT_MANUAL_COLUMNS in kanban.service). New leads always land in the
//    first column.
//  - AUTOMATED: pipeline stages generated from the Tune Agent interview;
//    regenerated (replaced) whenever the custom instruction is regenerated.
enum KanbanBoardType {
  MANUAL
  AUTOMATED
}

model KanbanColumn {
  id        String          @id @default(cuid())
  chatbotId String
  board     KanbanBoardType
  name      String
  position  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  chatbot   Chatbot         @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  manualLeads    Lead[] @relation("LeadManualColumn")
  automatedLeads Lead[] @relation("LeadAutomatedColumn")

  @@index([chatbotId, board])
  @@map("kanban_columns")
}

// How a lead entered the system:
//  - BOOKING: confirmed an appointment through the booking flow.
//  - AUTOMATED: matched a qualification condition from the custom instruction
//    (detected by the lead classifier); `trigger` holds the matched stage.
//  - MANUAL: added by the owner from the dashboard.
enum LeadType {
  BOOKING
  AUTOMATED
  MANUAL
}

model Lead {
  id        String   @id @default(cuid())
  chatbotId String
  sessionId String?
  name      String?
  email     String?
  phone     String?
  // Channel the lead came through — copied from ChatSession.source at capture
  // time ('widget', 'iframe', 'whatsapp', 'instagram', 'playground', ...).
  source    String   @default("playground")
  type      LeadType
  // BOOKING → 'booking'; AUTOMATED → the matched pipeline stage/condition name.
  trigger   String?
  // Free-form capture context: qualification answers, appointment details, etc.
  meta      Json?

  // One position per board so every lead shows on both kanbans. The manual
  // column is required (leads always land in the manual board's first column);
  // the automated column is null until/unless a pipeline stage applies.
  manualColumnId    String
  automatedColumnId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatbot         Chatbot       @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  session         ChatSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  manualColumn    KanbanColumn  @relation("LeadManualColumn", fields: [manualColumnId], references: [id])
  automatedColumn KanbanColumn? @relation("LeadAutomatedColumn", fields: [automatedColumnId], references: [id], onDelete: SetNull)

  // One lead of each type per session — repeat captures update the row.
  @@unique([sessionId, type])
  @@index([chatbotId])
  @@index([manualColumnId])
  @@index([automatedColumnId])
  @@map("leads")
}

model CalendarIntegration {
  id           String   @id @default(cuid())
  chatbotId    String   @unique
  chatbot      Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  provider     String   // 'google'
  accountEmail String
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  tokenExpiry  DateTime
  scope        String?
  calendarId   String   @default("primary")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("calendar_integrations")
}